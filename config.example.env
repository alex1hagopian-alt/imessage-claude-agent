# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is git-ignored. Check it with:  python config.py

# --- Required ---------------------------------------------------------------

# Your Anthropic API key (https://console.anthropic.com). Used by the agent's
# free-text commands and the morning brief; Claude Code sessions started by the
# bridge also see it and will bill this key.
ANTHROPIC_API_KEY=your-anthropic-api-key

# The phone number of YOUR iPhone, international form. The agent sends replies
# and the morning brief here, and you text the agent from this number.
AGENT_PHONE_NUMBER=+1xxxxxxxxxx

# The Apple ID that Messages on the Mac is signed into (the agent's own iMessage
# address). You text THIS address from your iPhone. It must be a different Apple
# ID from your own, or every message becomes a text-to-yourself (double bubbles).
IMESSAGE_SEND_ADDRESS=your-agent-apple-id@gmail.com

# --- Optional ---------------------------------------------------------------

# Where your projects live; "start claude <name>" opens or creates <name> here.
PROJECTS_DIR=/Users/yourname/projects

# Other addresses of yours the iPhone might text from, comma-separated. Messages
# from them are read; replies still go to AGENT_PHONE_NUMBER.
# EXTRA_USER_ADDRESSES=you@example.com,you2@example.com

# launchd job label used by the installer, "restart agent" and the start/stop apps.
# LAUNCHD_LABEL=com.example.imessageagent

# Morning brief
# Where you are: used for the weather, and told to Claude so the brief can be tailored to your area.
LOCATION=Washington DC
# BRIEF_TIME=07:00

# Messages database (default shown)
# CHAT_DB=~/Library/Messages/chat.db
